@@ -0,0 +1,185 @@
+import { useRef, useState } from 'react'
+import AlbumArt from '../components/AlbumArt.jsx'
+import music from '../data/music.json'
+import { SITE } from '../data/site.config.js'
+import { useSEO } from '../lib/seo.js'
+
+const ACCENT_HEX = 'b6ff1a' // keep in step with --accent in index.css (used by the SoundCloud player color)
+const ARTIST = music.artist.name
+
+// ---------- player sources ----------
+const SOUNDCLOUD = { type: 'soundcloud', label: 'SoundCloud', title: `${ARTIST} on SoundCloud` }
+
+function embedSrc(s) {
+  if (s.type === 'youtube') {
+    return `https://www.youtube-nocookie.com/embed/${encodeURIComponent(s.id)}?autoplay=1&rel=0&modestbranding=1`
+  }
+  if (s.type === 'spotify') {
+    return `https://open.spotify.com/embed/album/${encodeURIComponent(s.id)}?theme=0`
+  }
+  return `https://w.soundcloud.com/player/?url=${encodeURIComponent(music.artist.soundcloud)}&color=%23${ACCENT_HEX}&auto_play=false&hide_related=true&show_comments=false&show_teaser=false`
+}
+
+function boxClass(s) {
+  if (s.type === 'youtube') return 'aspect-video'
+  if (s.type === 'spotify') return 'h-[352px]'
+  return 'h-[450px]'
+}
+
+/**
+ * Click-to-load player. Nothing from SoundCloud / YouTube / Spotify is requested until the
+ * visitor presses play, which keeps the page fast and avoids third-party tracking up front.
+ */
+function Player({ source, active, onPlay }) {
+  return (
+    <div className={`relative w-full border border-smoke/30 bg-coal ${boxClass(source)}`}>
+      {active ? (
+        <iframe
+          key={embedSrc(source)}
+          src={embedSrc(source)}
+          title={`Audio player: ${source.title}`}
+          className="absolute inset-0 h-full w-full border-0"
+          allow="autoplay; encrypted-media; clipboard-write; fullscreen; picture-in-picture"
+          allowFullScreen
+          referrerPolicy="strict-origin-when-cross-origin"
+        />
+      ) : (
+        <div className="absolute inset-0 flex flex-col items-start justify-end gap-4 p-5 sm:p-8">
+          <p className="label !text-acid">{source.label}</p>
+          <p className="h-display text-4xl sm:text-6xl">{source.title}</p>
+          <button className="btn btn-solid" onClick={onPlay}>
+            ▶ Load player
+          </button>
+          <p className="text-[12px] text-smoke">The player loads from {source.label} when you press this.</p>
+        </div>
+      )}
+    </div>
+  )
+}
+
+function searchLinks(title) {
+  const q = encodeURIComponent(`${ARTIST} ${title}`)
+  return [
+    ['Spotify', `https://open.spotify.com/search/${q}`],
+    ['Apple Music', `https://music.apple.com/search?term=${q}`],
+    ['YouTube', `https://www.youtube.com/results?search_query=${q}`],
+  ]
+}
+
+export default function Music() {
+  useSEO({
+    title: 'Music',
+    description: `Listen to ${ARTIST}: stream popular tracks and browse the discography, including The Comedown, The Peak and The Comeup.`,
+    path: '/music',
+  })
+
+  const [source, setSource] = useState(SOUNDCLOUD)
+  const [active, setActive] = useState(false)
+  const [announce, setAnnounce] = useState('')
+  const playerRef = useRef(null)
+
+  function choose(next) {
+    setSource(next)
+    setActive(true)
+    setAnnounce(`Loaded ${next.title}`)
+    playerRef.current?.scrollIntoView({ block: 'nearest' })
+  }
+
+  return (
+    <div className="wrap pt-10 sm:pt-16">
+      <h1 className="h-display text-6xl sm:text-8xl">Music</h1>
+      <p className="mt-3 max-w-md text-smoke">Press play. Everything streams from the original platforms.</p>
+
+      {/* PLAYER + TRACK LIST */}
+      <section className="mt-10 grid gap-8 lg:grid-cols-[1.4fr_1fr]" aria-labelledby="listen-title">
+        <div className="min-w-0" ref={playerRef}>
+          <h2 id="listen-title" className="sr-only">Listen</h2>
+          <Player key={source.type + (source.id || '')} source={source} active={active} onPlay={() => choose(source)} />
+          <p role="status" aria-live="polite" className="sr-only">{announce}</p>
+        </div>
+
+        <div className="min-w-0">
+          <h2 className="label mb-3">Popular tracks</h2>
+          <ol className="divide-y divide-smoke/20 border-y border-smoke/30">
+            <li>
+              <button
+                className="flex min-h-[52px] w-full items-center gap-4 px-1 py-3 text-left hover:text-acid"
+                aria-current={active && source.type === 'soundcloud' ? 'true' : undefined}
+                onClick={() => choose(SOUNDCLOUD)}
+              >
+                <span className="w-6 text-smoke" aria-hidden="true">★</span>
+                <span className="flex-1">All tracks (SoundCloud)</span>
+              </button>
+            </li>
+            {music.popularTracks.map((t, i) => {
+              const isOn = active && source.type === 'youtube' && source.id === t.youtubeId
+              return (
+                <li key={t.youtubeId}>
+                  <button
+                    className={`flex min-h-[52px] w-full items-center gap-4 px-1 py-3 text-left hover:text-acid ${isOn ? 'text-acid' : ''}`}
+                    aria-current={isOn ? 'true' : undefined}
+                    onClick={() => choose({ type: 'youtube', label: 'YouTube', id: t.youtubeId, title: t.title })}
+                  >
+                    <span className="w-6 tabular-nums text-smoke" aria-hidden="true">{isOn ? '▶' : String(i + 1).padStart(2, '0')}</span>
+                    <span className="min-w-0 flex-1 break-words">{t.title}</span>
+                    <span className="label shrink-0 !text-[10px]">YouTube</span>
+                  </button>
+                </li>
+              )
+            })}
+          </ol>
+        </div>
+      </section>
+
+      {/* DISCOGRAPHY */}
+      <section className="pt-20 sm:pt-28" aria-labelledby="disco-title">
+        <h2 id="disco-title" className="h-display text-5xl sm:text-7xl">Discography</h2>
+        <ul className="mt-8 grid grid-cols-2 gap-x-3 gap-y-10 md:grid-cols-3 lg:grid-cols-4 lg:gap-x-5">
+          {music.releases.map((rel) => (
+            <li key={rel.id} className="min-w-0">
+              <div className="aspect-square overflow-hidden border border-smoke/25 bg-coal">
+                <AlbumArt release={rel} />
+              </div>
+              <h3 className="mt-3 font-display text-2xl font-black uppercase leading-tight">{rel.title}</h3>
+              <p className="label mt-1">{rel.year} · {rel.tracks} {rel.tracks === 1 ? 'track' : 'tracks'}</p>
+
+              {rel.spotifyId && (
+                <button
+                  className="btn btn-solid mt-3 w-full !min-h-[44px] !px-3"
+                  onClick={() => choose({ type: 'spotify', label: 'Spotify', id: rel.spotifyId, title: rel.title })}
+                >
+                  ▶ Play here
+                </button>
+              )}
+
+              <p className="label mb-1 mt-3 !text-[10px]">Find on</p>
+              <ul className="flex flex-wrap gap-1.5">
+                {searchLinks(rel.title).map(([name, href]) => (
+                  <li key={name}>
+                    <a className="chip !min-h-[36px] !px-2 !text-[11px]" href={href} target="_blank" rel="noopener noreferrer">
+                      {name}<span className="sr-only"> (opens in a new tab), {rel.title}</span>
+                    </a>
+                  </li>
+                ))}
+              </ul>
+            </li>
+          ))}
+        </ul>
+      </section>
+
+      <section className="pt-16" aria-label="Artist links">
+        <p className="label mb-3">{ARTIST}</p>
+        <ul className="flex flex-wrap gap-x-6 gap-y-2">
+          <li><a className="hover:text-acid" href={music.artist.soundcloud} target="_blank" rel="noopener noreferrer">SoundCloud ↗</a></li>
+          <li><a className="hover:text-acid" href={music.artist.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a></li>
+          <li><a className="hover:text-acid" href={music.artist.twitter} target="_blank" rel="noopener noreferrer">X / Twitter ↗</a></li>
+        </ul>
+        {SITE.unofficial && (
+          <p className="mt-6 max-w-lg text-[12px] text-smoke">
+            Unofficial fan site. All music and artwork belong to {ARTIST} and are streamed from the original platforms.
+          </p>
+        )}
+      </section>
+    </div>
+  )
+}
