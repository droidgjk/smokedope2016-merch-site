# ---- Frontend (safe to expose, prefixed with VITE_) ----
# Public URL of your deployed site, no trailing slash. Used for canonical/OG links.
VITE_SITE_URL=https://YOUR-DOMAIN.com
# Where the cart is sent to start Stripe Checkout. Default works on Vercel.
VITE_CHECKOUT_ENDPOINT=/api/create-checkout-session
# Optional: endpoints that receive newsletter / contact form posts (Formspree, Mailchimp proxy, your own API).
VITE_SIGNUP_ENDPOINT=
VITE_CONTACT_ENDPOINT=

# ---- Server only (set in Vercel/Netlify env settings, NEVER commit real keys) ----
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
SITE_URL=https://YOUR-DOMAIN.com
