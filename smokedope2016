import { useEffect } from 'react'
import { SITE } from '../data/site.config.js'

function setMeta(attr, key, value) {
  let el = document.head.querySelector(`meta[${attr}="${key}"]`)
  if (!el) {
    el = document.createElement('meta')
    el.setAttribute(attr, key)
    document.head.appendChild(el)
  }
  el.setAttribute('content', value)
}

/**
 * Per-page SEO. Call once at the top of every page component.
 * Note: this runs in the browser. Google renders JS, but social crawlers (Instagram/TikTok/iMessage
 * link previews) often do NOT. For perfect link previews either prerender the pages or use Next.js.
 * See README > "SEO and link previews".
 */
export function useSEO({ title, description, path = '/', image }) {
  useEffect(() => {
    const fullTitle = title ? `${title} | ${SITE.storeName}` : `${SITE.storeName} | Limited drops`
    const url = SITE.url + path
    const img = image || `${SITE.url}/og.png`
    document.title = fullTitle
    setMeta('name', 'description', description)
    setMeta('property', 'og:title', fullTitle)
    setMeta('property', 'og:description', description)
    setMeta('property', 'og:url', url)
    setMeta('property', 'og:image', img)
    setMeta('name', 'twitter:card', 'summary_large_image')
    setMeta('name', 'twitter:title', fullTitle)
    setMeta('name', 'twitter:description', description)
    setMeta('name', 'twitter:image', img)
    let link = document.head.querySelector('link[rel="canonical"]')
    if (!link) {
      link = document.createElement('link')
      link.setAttribute('rel', 'canonical')
      document.head.appendChild(link)
    }
    link.setAttribute('href', url)
  }, [title, description, path, image])
}

import { createContext, useCallback, useContext, useEffect, useMemo, useReducer, useState } from 'react'
import { DISCOUNT_CODES, SHIPPING } from '../data/site.config.js'
import { PRODUCTS, shippingFor } from './format.js'

const STORAGE_KEY = 'sd2016_cart_v1'
const CartCtx = createContext(null)

function load() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY)
    if (!raw) return { items: [], code: '' }
    const parsed = JSON.parse(raw)
    // Drop anything that no longer exists in products.json.
    const items = (parsed.items || []).filter((i) => PRODUCTS.some((p) => p.id === i.id))
    return { items, code: parsed.code || '' }
  } catch {
    return { items: [], code: '' }
  }
}

function reducer(state, action) {
  switch (action.type) {
    case 'add': {
      const { id, size, qty } = action
      const product = PRODUCTS.find((p) => p.id === id)
      const max = product ? Math.min(product.stock, 10) : 1
      const i = state.items.findIndex((x) => x.id === id && x.size === size)
      const items = [...state.items]
      if (i >= 0) items[i] = { ...items[i], qty: Math.min(max, items[i].qty + qty) }
      else items.push({ id, size, qty: Math.min(max, qty) })
      return { ...state, items }
    }
    case 'setQty': {
      const product = PRODUCTS.find((p) => p.id === action.id)
      const max = product ? Math.min(product.stock, 10) : 1
      const items = state.items
        .map((x) => (x.id === action.id && x.size === action.size ? { ...x, qty: Math.min(max, action.qty) } : x))
        .filter((x) => x.qty > 0)
      return { ...state, items }
    }
    case 'remove':
      return { ...state, items: state.items.filter((x) => !(x.id === action.id && x.size === action.size)) }
    case 'code':
      return { ...state, code: action.code }
    case 'clear':
      return { items: [], code: '' }
    default:
      return state
  }
}

export function CartProvider({ children }) {
  const [state, dispatch] = useReducer(reducer, undefined, load)
  const [open, setOpen] = useState(false)

  useEffect(() => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state))
    } catch {
      /* private mode or storage full: cart just won't persist */
    }
  }, [state])

  const add = useCallback((id, size, qty = 1) => {
    dispatch({ type: 'add', id, size, qty })
    setOpen(true)
  }, [])

  const value = useMemo(() => {
    const lines = state.items
      .map((i) => ({ ...i, product: PRODUCTS.find((p) => p.id === i.id) }))
      .filter((l) => l.product)
    const subtotal = lines.reduce((sum, l) => sum + l.product.price * l.qty, 0)
    const count = lines.reduce((n, l) => n + l.qty, 0)
    const discount = DISCOUNT_CODES[state.code.toUpperCase()]
    const discountAmount = discount ? Math.round((subtotal * discount.value) / 100) : 0
    const shipping = shippingFor(subtotal - discountAmount, SHIPPING)
    return {
      lines,
      count,
      subtotal,
      code: state.code,
      discount,
      discountAmount,
      shipping,
      total: subtotal - discountAmount + shipping,
      open,
      setOpen,
      add,
      setQty: (id, size, qty) => dispatch({ type: 'setQty', id, size, qty }),
      remove: (id, size) => dispatch({ type: 'remove', id, size }),
      applyCode: (code) => {
        const clean = code.trim().toUpperCase()
        if (!clean) return { ok: false, message: 'Enter a code.' }
        if (!DISCOUNT_CODES[clean]) return { ok: false, message: 'That code is not valid.' }
        dispatch({ type: 'code', code: clean })
        return { ok: true, message: `${DISCOUNT_CODES[clean].label} applied.` }
      },
      clearCode: () => dispatch({ type: 'code', code: '' }),
      clear: () => dispatch({ type: 'clear' }),
    }
  }, [state, open, add])

  return <CartCtx.Provider value={value}>{children}</CartCtx.Provider>
}

export function useCart() {
  const ctx = useContext(CartCtx)
  if (!ctx) throw new Error('useCart must be used inside <CartProvider>')
  return ctx
}

const ENDPOINT = import.meta.env.VITE_CHECKOUT_ENDPOINT || '/api/create-checkout-session'

/**
 * Sends ONLY ids, sizes and quantities to the server. The server looks up prices itself
 * (see api/create-checkout-session.js) so nobody can edit a price in the browser.
 * Returns { url } on success or throws an Error with a readable message.
 */
export async function startCheckout(lines, code) {
  let res
  try {
    res = await fetch(ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: lines.map((l) => ({ id: l.id, size: l.size, qty: l.qty })),
        code: code || undefined,
      }),
    })
  } catch {
    throw new Error('Could not reach the checkout server. Check your connection and try again.')
  }

  let data = null
  try {
    data = await res.json()
  } catch {
    /* non-JSON response */
  }

  if (!res.ok || !data?.url) {
    if (res.status === 404) {
      throw new Error('Checkout is not set up yet. Deploy the /api function and add your Stripe key (see README).')
    }
    throw new Error(data?.error || 'Checkout failed. Please try again.')
  }
  return data
}

